# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is gitignored - never commit real secrets.
#
# `docker compose` also reads `.env` for ${VAR} substitution in
# docker-compose.yml (currently JWT_SECRET), so keep the values you want the
# containers to use here.
# ---------------------------------------------------------------------------

PORT=3000

# --- Option A: MongoDB running in Docker (docker compose up) ----------------
# The API container talks to the `mongo` service by name. Set by
# docker-compose.yml automatically; kept here for reference.
# DATABASE_URL="mongodb://mongo:27017/ecommerce?replicaSet=rs0"

# --- Option B: MongoDB running on your host ---------------------------------
# Required for Prisma transactions: the node must be a replica set.
# `replicaSet=rs0` enables transactions; `directConnection=true` keeps the
# driver pinned to this single host (the set member is registered as
# "mongo:27017", which doesn't resolve from your host machine).
DATABASE_URL="mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0&directConnection=true"

# Host name recorded in the replica-set config (used by scripts/init-replica-set.ts).
MONGO_REPL_SET_NAME=rs0
MONGO_REPL_SET_HOST=127.0.0.1:27017

JWT_SECRET="change-me-to-a-long-random-string"
